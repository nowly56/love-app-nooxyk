# Telegram bot token from @BotFather. Keep this secret; never commit .env.
TELEGRAM_BOT_TOKEN=

# On Railway, set this to https://<your-public-domain>.
# The server can also infer it from RAILWAY_PUBLIC_DOMAIN.
TELEGRAM_WEB_APP_URL=https://your-app.up.railway.app

# Optional random secret for the bot webhook endpoint.
TELEGRAM_WEBHOOK_SECRET=

# Polling is the default and works without a public webhook configuration.
TELEGRAM_USE_WEBHOOK=false
